# raspi5-ab.wks – WIC kickstart for Raspberry Pi 5 A/B partition layout
#
# Partition table (GPT):
#   p1  boot    256 MiB  FAT32   – kernel, device-tree, config.txt, cmdline.txt
#   p2  rootA  3072 MiB  ext4    – initial active root filesystem (slot A)
#   p3  rootB  3072 MiB  ext4    – standby root filesystem   (slot B)
#   p4  data     remaining   ext4    - persistent data (survives OTA swaps)
#
# The OTA scripts manage which slot is active by rewriting cmdline.txt on
# the boot partition.  No U-Boot environment is required.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot \
           --active --align 4 --fixed-size 256M

part /     --source rootfs            --ondisk mmcblk0 --fstype=ext4 --label rootA \
           --align 4 --fixed-size 3072M

part       --ondisk mmcblk0 --fstype=ext4 --label rootB \
           --align 4 --fixed-size 3072M

part /data --ondisk mmcblk0 --fstype=ext4 --label data \
           --align 4
